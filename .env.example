# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Database
DATABASE_URL=postgresql://bot:botpass@localhost:5432/discordbot

# Redis
REDIS_URL=redis://localhost:6379

# Security
IP_HASH_SALT=           # Gere com: openssl rand -hex 32
JWT_SECRET=             # Gere com: openssl rand -hex 32
